<Window x:Class="PasswordManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码管理器" 
        Height="700" Width="1200" 
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        MinHeight="500" MinWidth="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1" FontSize="13">
            <MenuItem Header="文件" FontSize="13">
                <MenuItem Header="退出" Click="Exit_Click" FontSize="13"/>
            </MenuItem>
            <MenuItem Header="密码" FontSize="13">
                <MenuItem Header="添加密码" Click="AddPassword_Click" FontSize="13"/>
                <MenuItem Header="编辑密码" Click="EditPassword_Click" FontSize="13"/>
                <MenuItem Header="删除密码" Click="DeletePassword_Click" FontSize="13"/>
                <MenuItem Header="导出密码备份" Click="ExportBackup_Click" FontSize="13"/>
                <MenuItem Header="导入密码备份" Click="ImportBackup_Click" FontSize="13"/>
            </MenuItem>
            <MenuItem Header="提醒" FontSize="13">
                <MenuItem Header="查看需要修改的密码" Click="ViewReminders_Click" FontSize="13"/>
            </MenuItem>
            <MenuItem Header="帮助" FontSize="13">
                <MenuItem Header="关于" Click="About_Click" FontSize="13"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="5,3">
            <Button Content="添加密码" Click="AddPassword_Click" Width="100" Height="35" FontSize="13" Padding="10,5"/>
            <Separator/>
            <Button Content="编辑" Click="EditPassword_Click" Width="80" Height="35" FontSize="13" Padding="8,5"/>
            <Button Content="删除" Click="DeletePassword_Click" Width="80" Height="35" FontSize="13" Padding="8,5"/>
            <Separator/>
            <Button Content="刷新" Click="Refresh_Click" Width="80" Height="35" FontSize="13" Padding="8,5"/>
            <Separator/>
            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="5,0,5,0" FontSize="13"/>
            <TextBox x:Name="SearchTextBox" Width="250" Height="32" 
                    VerticalContentAlignment="Center" FontSize="13" Padding="8,5"
                    KeyDown="SearchTextBox_KeyDown"/>
            <Button Content="搜索" Click="Search_Click" Width="80" Height="35" FontSize="13" Padding="8,5" Margin="10,0,10,0"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Background="#0078D4" Foreground="White" Height="25" FontSize="12">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <DataGrid x:Name="PasswordsDataGrid" 
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     SelectionMode="Single"
                     SelectionUnit="FullRow"
                     MouseDoubleClick="PasswordsDataGrid_MouseDoubleClick"
                     FontSize="13"
                     RowHeight="30"
                     HeadersVisibility="Column"
                     GridLinesVisibility="Horizontal"
                     Background="White"
                     BorderBrush="#DDD"
                     BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="网站" Binding="{Binding Website}" Width="250" MinWidth="200"/>
                    <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="200" MinWidth="150"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" MinWidth="200"/>
                    <DataGridTextColumn Header="最后更新" Binding="{Binding UpdatedAt, StringFormat=\{0:yyyy-MM-dd\}}" Width="120" MinWidth="100"/>
                    <DataGridTextColumn Header="提醒天数" Binding="{Binding ReminderDays}" Width="100" MinWidth="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>