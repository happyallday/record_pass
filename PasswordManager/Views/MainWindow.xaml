<Window x:Class="PasswordManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码管理器" 
        Height="600" Width="900" 
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <MenuItem Header="文件">
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="密码">
                <MenuItem Header="添加密码" Click="AddPassword_Click"/>
                <MenuItem Header="编辑密码" Click="EditPassword_Click"/>
                <MenuItem Header="删除密码" Click="DeletePassword_Click"/>
                <MenuItem Header="导出密码备份" Click="ExportBackup_Click"/>
                <MenuItem Header="导入密码备份" Click="ImportBackup_Click"/>
            </MenuItem>
            <MenuItem Header="提醒">
                <MenuItem Header="查看需要修改的密码" Click="ViewReminders_Click"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Button Content="添加密码" Click="AddPassword_Click" Width="100" Height="35"/>
            <Separator/>
            <Button Content="编辑" Click="EditPassword_Click" Width="80" Height="35"/>
            <Button Content="删除" Click="DeletePassword_Click" Width="80" Height="35"/>
            <Separator/>
            <Button Content="刷新" Click="Refresh_Click" Width="80" Height="35"/>
            <Separator/>
            <TextBox x:Name="SearchTextBox" Width="200" Height="35" 
                    Margin="10,0,0,0" VerticalContentAlignment="Center"
                    KeyDown="SearchTextBox_KeyDown"/>
            <Button Content="搜索" Click="Search_Click" Width="80" Height="35" Margin="0,0,10,0"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Background="#0078D4" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="PasswordsDataGrid" 
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     SelectionMode="Single"
                     SelectionUnit="FullRow"
                     MouseDoubleClick="PasswordsDataGrid_MouseDoubleClick"
                     ColumnWidth="*">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="网站" Binding="{Binding Website}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" MinWidth="200"/>
                    <DataGridTextColumn Header="最后更新" Binding="{Binding UpdatedAt, StringFormat=\{0:yyyy-MM-dd\}}" Width="120"/>
                    <DataGridTextColumn Header="提醒天数" Binding="{Binding ReminderDays}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>