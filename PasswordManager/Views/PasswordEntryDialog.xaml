<Window x:Class="PasswordManager.Views.PasswordEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" 
        Height="650" Width="600" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="{Binding WindowSubtitle}" FontSize="18" FontWeight="Bold" 
                          Foreground="#0078D4" Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="网站名称:" Grid.Row="0" Grid.Column="0"/>
                    <TextBox x:Name="WebsiteTextBox" Grid.Row="0" Grid.Column="1" 
                            Text="{Binding Website}"/>

                    <Label Content="用户名:" Grid.Row="1" Grid.Column="0"/>
                    <TextBox x:Name="UsernameTextBox" Grid.Row="1" Grid.Column="1" 
                            Text="{Binding Username}"/>

                    <Label Content="密码:" Grid.Row="2" Grid.Column="0"/>
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordTextBox" Grid.Column="0" 
                                    PasswordChanged="PasswordTextBox_PasswordChanged"/>
                        <Button x:Name="TogglePasswordButton" Grid.Column="1" 
                                Content="👁" Width="40" Click="TogglePassword_Click" 
                                ToolTip="显示/隐藏密码"/>
                    </Grid>

                    <Label Content="密码生成器:" Grid.Row="3" Grid.Column="0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="IncludeUpperCheckBox" Content="大写字母" IsChecked="True" 
                                      Grid.Column="0" Margin="0,0,10,0"/>
                            <CheckBox x:Name="IncludeLowerCheckBox" Content="小写字母" IsChecked="True" 
                                      Grid.Column="1" Margin="0,0,10,0"/>
                            <CheckBox x:Name="IncludeDigitCheckBox" Content="数字" IsChecked="True" 
                                      Grid.Column="2" Margin="0,0,10,0"/>
                            <CheckBox x:Name="IncludeSpecialCheckBox" Content="特殊字符" IsChecked="True" 
                                      Grid.Column="3"/>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="长度:" Grid.Column="0" VerticalAlignment="Center"/>
                            <Slider x:Name="PasswordLengthSlider" Grid.Column="1" 
                                   Minimum="8" Maximum="32" Value="16" 
                                   TickFrequency="2" IsSnapToTickEnabled="True"
                                   Margin="10,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PasswordLengthValue" Grid.Column="2" 
                                      Text="16" Width="30" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="生成密码" Click="GeneratePassword_Click" 
                               Width="120" Height="30" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Label Content="描述:" Grid.Row="4" Grid.Column="0"/>
                    <TextBox x:Name="DescriptionTextBox" Grid.Row="4" Grid.Column="1" 
                            Text="{Binding Description}" Height="60" 
                            TextWrapping="Wrap" AcceptsReturn="True"/>

                    <Label Content="提醒周期(天):" Grid.Row="5" Grid.Column="0"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="ReminderDaysTextBox" Width="100" 
                                Text="{Binding ReminderDays}"/>
                        <Button Content="快速设置" Click="QuickReminderSet_Click" 
                               Width="80" Height="30" Margin="5,0,0,0"/>
                    </StackPanel>

                    <Label Content="创建时间:" Grid.Row="6" Grid.Column="0"/>
                    <TextBlock x:Name="CreatedDateText" Grid.Row="6" Grid.Column="1" 
                              Text="{Binding CreatedDate}" VerticalAlignment="Center" Margin="5"/>

                    <Label Content="最后更新:" Grid.Row="7" Grid.Column="0"/>
                    <TextBlock x:Name="UpdatedDateText" Grid.Row="7" Grid.Column="1" 
                              Text="{Binding UpdateDate}" VerticalAlignment="Center" Margin="5"/>
                </Grid>

                <Separator Margin="0,20,0,15"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Content="保存" Click="Save_Click" 
                           Width="100" Height="35"/>
                    <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" 
                           Width="100" Height="35" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>