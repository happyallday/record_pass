<Window x:Class="PasswordManager.Views.PasswordDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码详情" 
        Height="400" Width="500" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock x:Name="WebsiteText" Text="" FontSize="24" FontWeight="Bold" 
                      Foreground="#0078D4" Margin="0,0,0,20"/>

            <StackPanel Margin="0,0,0,5">
                <Label Content="用户名:" FontWeight="SemiBold" Margin="0"/>
                <TextBox x:Name="UsernameText" Text="" IsReadOnly="True" 
                        Background="#FFF" Margin="0"/>
                <Button x:Name="CopyUsernameButton" Content="复制用户名" 
                       Width="120" Height="30" HorizontalAlignment="Left" 
                       Click="CopyUsername_Click" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,5">
                <Label Content="密码:" FontWeight="SemiBold" Margin="0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordTextBox" Grid.Column="0" 
                                Background="#FFF" Margin="0"/>
                    <ToggleButton x:Name="ShowPasswordToggle" Grid.Column="1" 
                                 Content="👁" Width="40" Click="ShowPassword_Click"
                                 ToolTip="显示/隐藏密码"/>
                </Grid>
                <Button x:Name="CopyPasswordButton" Content="复制密码" 
                       Width="120" Height="30" HorizontalAlignment="Left" 
                       Click="CopyPassword_Click" Margin="0,5,0,0"/>
                <TextBlock x:Name="PasswordStrengthText" Text="" 
                          Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,5" Visibility="{Binding DescriptionVisibility}">
                <Label Content="描述:" FontWeight="SemiBold" Margin="0"/>
                <TextBox x:Name="DescriptionText" Text="" IsReadOnly="True" 
                        Background="#FFF" Height="60" TextWrapping="Wrap" 
                        AcceptsReturn="True" Margin="0"/>
            </StackPanel>

            <StackPanel Margin="0,10,0,5">
                <TextBlock x:Name="DatesText" Text="" FontSize="12" 
                          Foreground="#666" TextWrapping="Wrap" Margin="0"/>
            </StackPanel>

            <StackPanel Margin="0,10,0,5">
                <TextBlock x:Name="ReminderStatusText" Text="" FontSize="12" 
                          Foreground="#666" TextWrapping="Wrap" Margin="0"/>
            </StackPanel>

            <Button x:Name="CloseButton" Content="关闭" 
                   Width="100" Height="35" HorizontalAlignment="Right" 
                   Click="Close_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>