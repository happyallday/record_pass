<Window x:Class="PasswordManager.Views.PasswordDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码详情" 
        Height="550" Width="600" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="500" MinHeight="450"
        Background="#F8F9FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25">
            <TextBlock x:Name="WebsiteText" Text="" FontSize="28" FontWeight="Bold" 
                      Foreground="#0078D4" Margin="0,0,0,25" TextWrapping="Wrap"/>

            <StackPanel Margin="0,0,0,10">
                <Label Content="用户名:" FontWeight="SemiBold" Margin="0" FontSize="14"/>
                <TextBox x:Name="UsernameText" Text="" IsReadOnly="True" 
                        Background="#FFF" Margin="0" Height="35" Padding="10,8"/>
                <Button x:Name="CopyUsernameButton" Content="复制用户名" 
                       Width="120" Height="35" HorizontalAlignment="Left" 
                       Click="CopyUsername_Click" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <Label Content="密码:" FontWeight="SemiBold" Margin="0" FontSize="14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordTextBox" Grid.Column="0" 
                                Background="#FFF" Margin="0" Height="35" 
                                VerticalContentAlignment="Center" Padding="10,8"/>
                    <ToggleButton x:Name="ShowPasswordToggle" Grid.Column="1" 
                                 Content="👁" Width="45" Height="35" Click="ShowPassword_Click"
                                 ToolTip="显示/隐藏密码" Margin="5,0,0,0"/>
                </Grid>
                <Button x:Name="CopyPasswordButton" Content="复制密码" 
                       Width="120" Height="35" HorizontalAlignment="Left" 
                       Click="CopyPassword_Click" Margin="0,8,0,0"/>
                <TextBlock x:Name="PasswordStrengthText" Text="" 
                          Foreground="#666" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <Label Content="描述:" FontWeight="SemiBold" Margin="0" FontSize="14"/>
                <TextBox x:Name="DescriptionText" Text="" IsReadOnly="True" 
                        Background="#FFF" MinHeight="80" TextWrapping="Wrap" 
                        AcceptsReturn="True" Margin="0" Padding="10,8"
                        VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <StackPanel Margin="0,15,0,10">
                <TextBlock x:Name="DatesText" Text="" FontSize="13" 
                          Foreground="#666" TextWrapping="Wrap" Margin="0"/>
            </StackPanel>

            <StackPanel Margin="0,10,0,10">
                <TextBlock x:Name="ReminderStatusText" Text="" FontSize="13" 
                          Foreground="#666" TextWrapping="Wrap" Margin="0"/>
            </StackPanel>

            <Button x:Name="CloseButton" Content="关闭" 
                   Width="120" Height="38" HorizontalAlignment="Right" 
                   Click="Close_Click" Margin="0,15,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>