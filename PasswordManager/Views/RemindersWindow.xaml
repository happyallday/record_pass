<Window x:Class="PasswordManager.Views.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码修改提醒" 
        Height="500" Width="800" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F8F9FA">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Button Content="刷新" Click="Refresh_Click" Width="80" Height="35"/>
            <Button Content="导出提醒列表" Click="ExportReminders_Click" Width="120" Height="35" Margin="10,0,0,0"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Background="#0078D4" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RemindersItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                                   BorderBrush="#DDD" 
                                   BorderThickness="1" 
                                   CornerRadius="4" 
                                   Padding="15"
                                   Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" 
                                          Width="50" Height="50" Margin="0,0,15,0">
                                        <Ellipse Fill="{Binding StatusColor}" Width="40" Height="40" 
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusIcon}" FontSize="20"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="White" FontWeight="Bold"/>
                                    </Grid>

                                    <TextBlock Grid.Row="0" Grid.Column="1" 
                                              Text="{Binding Website}" FontSize="18" 
                                              FontWeight="Bold" Foreground="#333"/>

                                    <TextBlock Grid.Row="1" Grid.Column="1" 
                                              Text="{Binding Username}" FontSize="14" 
                                              Foreground="#666" Margin="0,5,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="1" 
                                              Text="{Binding Message}" FontSize="14" 
                                              Foreground="{Binding MessageColor}" 
                                              TextWrapping="Wrap" Margin="0,8,0,0"/>

                                    <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" 
                                              Orientation="Vertical" HorizontalAlignment="Right">
                                        <Button Content="查看详情" Width="100" Height="30" Margin="0,0,0,5"
                                               Command="{Binding ViewDetailsCommand}"/>
                                        <Button Content="更新密码" Width="100" Height="30" Margin="0,0,0,5"
                                               Command="{Binding UpdatePasswordCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>