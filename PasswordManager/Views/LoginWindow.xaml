<Window x:Class="PasswordManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码管理器 - 登录" 
        Height="400" Width="500" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    <Grid>
        <StackPanel Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="密码管理器" FontSize="32" FontWeight="Bold" 
                      Foreground="#0078D4" HorizontalAlignment="Center" Margin="0,0,0,40"/>
            
            <Label Content="请输入主密码:" Target="{Binding ElementName=MasterPassword}" FontSize="14"/>
            <PasswordBox x:Name="MasterPassword" Width="320" Height="38" 
                        FontSize="16" Padding="10,8" KeyDown="MasterPassword_KeyDown"/>
            
            <Label x:Name="ErrorLabel" Content="" Foreground="Red" 
                  HorizontalAlignment="Center" Margin="0,10,0,20" FontSize="13"/>
            
            <Button Content="登录" Width="120" Height="38" 
                    Click="Login_Click" HorizontalAlignment="Center" FontSize="16"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                <TextBlock Text="首次使用请设置主密码" FontSize="13" Foreground="#666" 
                          VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>