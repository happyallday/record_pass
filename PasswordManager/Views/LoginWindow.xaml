<Window x:Class="PasswordManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码管理器 - 登录" 
        Height="350" Width="450" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    <Grid>
        <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="密码管理器" FontSize="28" FontWeight="Bold" 
                      Foreground="#0078D4" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            
            <Label Content="请输入主密码:" Target="{Binding ElementName=MasterPassword}"/>
            <PasswordBox x:Name="MasterPassword" Width="300" Height="35" 
                        FontSize="16" KeyDown="MasterPassword_KeyDown"/>
            
            <Label x:Name="ErrorLabel" Content="" Foreground="Red" 
                  HorizontalAlignment="Center" Margin="0,5,0,15"/>
            
            <Button Content="登录" Width="100" Height="35" 
                    Click="Login_Click" HorizontalAlignment="Center" FontSize="16"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="首次使用请设置主密码" FontSize="12" Foreground="#666" 
                          VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>